# ── FinLens AI (ดูบรีฟโปรเจกต์) ── ใส่ค่าจริงใน .env.local เท่านั้น ห้าม commit
# AI: Gemini ผ่าน KKU IntelSphere (ใช้ key เดียวกับงาน U-Fox)
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
KKU_API_KEY=
KKU_MODEL=gemini-3.5-flash-lite
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF app ID from LINE Developers (LINE Login channel > LIFF); empty = no login
NEXT_PUBLIC_LIFF_ID=
# Public URL of the deployed site, e.g. https://finlens.vercel.app
NEXT_PUBLIC_SITE_URL=
# ใช้เซ็นคุกกี้ล็อกอิน สุ่มยาว ๆ แล้วตั้งบน Vercel ด้วย (ห้ามใช้ค่าเดียวกับเครื่อง dev)
SESSION_SECRET=
# (ไม่บังคับ) ID ของ LINE Login channel ถ้าไม่ใส่จะใช้ส่วนหน้าขีดของ NEXT_PUBLIC_LIFF_ID
LINE_LOGIN_CHANNEL_ID=

# ── U-Ledger reference pages only (frontend/src/app/(ledger)) ──
# Empty = call the API on the same origin (next.config.ts forwards /api/* to BACKEND_URL).
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=http://localhost:8000
# LINE OA add-friend link for the "เพิ่มเพื่อน" buttons, e.g. https://line.me/R/ti/p/@xxxx
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
